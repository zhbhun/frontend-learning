<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <!--
    范例：Developer ID 直分发场景下 Electron 的自定义 entitlements 起点。

    使用时机：@electron/osx-sign 自带的默认 entitlements 已覆盖多数项目，
    先用 osxSign: {} 空配置跑通签名+公证；只在遇到 hardened runtime 报错
    或需要额外设备权限时，才通过 osxSign.entitlements 引入本文件。
    原则：默认授权基础上只加不删，改完必须重新走完整公证验证。
  -->
  <dict>
    <!-- V8 JIT：hardened runtime 默认禁止动态可执行内存的 JIT 映射，Electron 需要它；
         删掉这一条是"公证通过但应用一启动就崩溃"的头号原因 -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>

    <!-- 允许加载非本团队签名的动态库：使用第三方原生模块（.node）时需要 -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>

    <!-- Electron ≤ 11 才需要；Electron 12 起不应再写入，勿解开下面的注释
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    -->
  </dict>
</plist>
