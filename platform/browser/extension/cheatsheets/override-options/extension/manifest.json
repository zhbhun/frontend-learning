{
  "manifest_version": 3,
  "name": "override-options-demo",
  "version": "1.0",
  "action": {
    "default_title": "替换页面与选项页示例",
    "default_popup": "popup.html"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "permissions": ["storage"],
  "background": {
    "service_worker": "sw.js"
  }
}
