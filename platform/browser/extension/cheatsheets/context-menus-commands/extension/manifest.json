{
  "manifest_version": 3,
  "name": "context-menus-commands-demo",
  "version": "1.0",
  "permissions": ["contextMenus"],
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "commands": {
    "toggle-highlight": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "切换高亮模式"
    },
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+U",
        "mac": "Command+Shift+U"
      }
    }
  },
  "background": {
    "service_worker": "sw.js"
  }
}
